# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
OPENAI_API_KEY=

# Galaxy of Consequence controller/runtime integration.
# These values are consumed only by server routes, Supabase Edge Functions,
# or local development tooling. Never expose them to browser JavaScript.
GOC_GPT_ACTION_KEY=
GOC_GPT_ACCOUNT_ID=
GOC_VERCEL_BASE_URL=https://galaxy-local.vercel.app
GOC_SUPABASE_BRIDGE_URL=
GOC_SUPABASE_BRIDGE_KEY=
# Temporary dual-key rotation only. Remove after every caller uses the new key.
GOC_SUPABASE_BRIDGE_KEY_PREVIOUS=

# Supabase hosted authentication. Keep the service-role key OUT of Vercel client code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Compatibility alias for projects that still use the legacy anon key name.
# SUPABASE_ANON_KEY=

# Local-only compatibility. Do not use SQLite/filesystem persistence on Vercel.
# CAMPAIGN_DB_PATH=
