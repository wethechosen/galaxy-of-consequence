# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
OPENAI_API_KEY=

# Galaxy of Consequence controller/runtime integration.
# The pooled URL is used by the hosted Next.js API. The direct URL is reserved
# for migrations and administration. Never expose either to browser JavaScript.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
GOC_SESSION_SECRET=
GOC_GPT_ACTION_KEY=
GOC_GPT_ACCOUNT_ID=
GOC_GPT_ACCOUNT_USERNAME=dmir@galaxy.local
GOC_VERCEL_BASE_URL=https://galaxy-local.vercel.app

# Local-only compatibility. Do not use SQLite/filesystem persistence on Vercel.
# CAMPAIGN_DB_PATH=
