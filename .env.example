# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
OPENAI_API_KEY=

# Galaxy of Consequence controller/runtime integration.
# These values are consumed only by server routes or local development tooling.
GOC_GPT_ACTION_KEY=
GOC_SUPABASE_BRIDGE_URL=
GOC_SUPABASE_BRIDGE_KEY=

# Optional: direct Supabase project metadata for server-side tooling.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

