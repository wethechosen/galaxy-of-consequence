                        },
                        "draftAttempts": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "committedRevision": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "gameplayAdvanced": {
                          "type": "boolean"
                        },
                        "retriable": {
                          "type": "boolean"
                        },
                        "replayed": {
                          "type": "boolean"
                        },
                        "reason": {
                          "type": "string"
                        }
                      },
