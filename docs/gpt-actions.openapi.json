{
  "openapi": "3.1.0",
  "info": {
    "title": "Galaxy of Consequence Controller Actions",
    "version": "1.2.0",
    "description": "Authoritative GOC controller. Gameplay turns, HUD reads, checkpoint saves, checkpoint loads, and OOC reconciliation are separate operations. Administrative operations never roll, narrate, generate initiative, award XP, or advance combat."
  },
  "servers": [
    {
      "url": "https://gqznpnxnbfqvzijxjmtm.supabase.co/functions/v1/goc-gpt-controller"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/gpt/state": {
      "get": {
        "operationId": "getCampaignState",
        "summary": "Read authoritative campaign state",
        "description": "Read the latest persisted campaign state and revision. Call before a gameplay turn, load, or reconciliation. Never advances gameplay.",
        "responses": {
          "200": {
            "description": "Authoritative state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/gpt/turn": {
      "post": {
        "operationId": "submitPlayerAction",
        "summary": "Resolve one in-world player action",
        "description": "GAMEPLAY ONLY. Use only for an in-world action by D'mir. NEVER use for save, load, checkpoint, HUD, sync, reconciliation, correction, OOC, admin, or state-edit requests. The controller rejects those requests before gameplay resolution. A successful turn persists to Supabase so the web app and GPT share the same state.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["revision", "action", "turnId"],
                "properties": {
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "description": "One in-world player action only."
                  },
                  "turnId": {
                    "type": "string",
                    "minLength": 8,
                    "description": "Unique idempotency key. Reuse only to retry the exact same turn."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resolved and persisted turn",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "409": {
            "description": "Revision conflict or replay"
          },
          "422": {
            "description": "Administrative request was routed to gameplay; use the returned useOperation instead"
          }
        }
      }
    },
    "/api/gpt/hud": {
      "get": {
        "operationId": "getCampaignHUD",
        "summary": "Read authoritative web-app HUD",
        "description": "Read character and player-facing hub data including HP, credits, location, inventory, condition track, combat, objectives, relationships, properties, investments, travel access, and revision. Read-only.",
        "responses": {
          "200": {
            "description": "HUD state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/gpt/save": {
      "post": {
        "operationId": "saveCheckpoint",
        "summary": "Save exact campaign checkpoint",
        "description": "Use when the user says save, save game, create checkpoint, or preserve current state. Copies the current authoritative snapshot exactly. MUST NOT roll, generate initiative, narrate, advance combat, award XP, change inventory, or change any gameplay value.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "maxLength": 120
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exact checkpoint saved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/gpt/checkpoints": {
      "get": {
        "operationId": "listCheckpoints",
        "summary": "List saved checkpoints",
        "description": "List recent exact checkpoints. Read-only and never advances gameplay.",
        "responses": {
          "200": {
            "description": "Checkpoint list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/gpt/load": {
      "post": {
        "operationId": "loadCheckpoint",
        "summary": "Restore exact checkpoint",
        "description": "Use only when the user explicitly asks to load or restore a checkpoint. Restores the selected snapshot exactly and increments persistence revision once. MUST NOT roll, generate initiative, narrate, advance combat, award XP, or infer extra changes. Call getCampaignState immediately before and pass its revision.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["checkpointId", "expectedRevision"],
                "properties": {
                  "checkpointId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkpoint restored exactly",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "409": {
            "description": "Revision conflict; reread state before retrying"
          }
        }
      }
    },
    "/api/gpt/reconcile": {
      "post": {
        "operationId": "reconcileCampaignState",
        "summary": "Apply explicit OOC state correction",
        "description": "Administrative state correction only. Use for explicit user-directed HP, XP, credits, location, inventory, combat, or condition-track corrections. Apply ONLY supplied fields. Never invent missing values. MUST NOT roll, generate initiative, narrate, award XP, or infer consequences. Call getCampaignState immediately before and pass its revision.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["expectedRevision", "patch"],
                "properties": {
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "patch": {
                    "type": "object",
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                      "level": { "type": "integer", "minimum": 1 },
                      "experience": { "type": "integer", "minimum": 0 },
                      "health": { "type": "integer" },
                      "credits": { "type": "number" },
                      "location": { "type": "string" },
                      "conditionTrack": { "type": "integer" },
                      "inventory": {
                        "type": "array",
                        "items": {}
                      },
                      "combat": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OOC correction persisted without gameplay advancement",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "409": {
            "description": "Revision conflict; reread state before retrying"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
