    "/api/gpt/load": {
      "post": {
        "operationId": "loadCheckpoint",
        "summary": "Restore an exact campaign checkpoint",
        "description": "Administrative restore only. Does not resolve gameplay.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "checkpointId",
                  "expectedRevision"
                ],
                "properties": {
                  "checkpointId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkpoint restored",
