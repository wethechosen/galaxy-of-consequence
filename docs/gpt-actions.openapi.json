    "/api/gpt/turn": {
      "post": {
        "operationId": "submitPlayerAction",
        "summary": "Resolve exactly one in-world player action",
        "description": "Gameplay only; not save, load, HUD or OOC corrections. The server owns Saga dice and persistence. Retry interrupted requests with the same turnId. A committed receipt means saved: never submit as a new turn. A failed retriable receipt means no advancement.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "revision",
                  "action"
                ],
                "properties": {
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "turnId": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 100,
                    "pattern": "^[a-zA-Z0-9_-]+$"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed or safely replayed gameplay turn with a transaction receipt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "message": {
                      "type": "string"
                    },
                    "receipt": {
                      "type": "object",
                      "description": "Authoritative transaction receipt. A committed receipt proves the turn is already saved; a failed receipt proves gameplay did not advance and identifies the exact retry phase.",
                      "properties": {
                        "turnId": {
                          "type": "string"
                        },
                        "baseRevision": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "processing",
                            "committed",
                            "failed"
                          ]
                        },
                        "phase": {
                          "type": "string"
                        },
                        "draftAttempts": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "committedRevision": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "gameplayAdvanced": {
                          "type": "boolean"
                        },
                        "retriable": {
                          "type": "boolean"
                        },
                        "replayed": {
                          "type": "boolean"
                        },
                        "reason": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid action"
          },
          "401": {
            "description": "Unauthorized"
          },
          "409": {
            "description": "Revision conflict, replay, or required character advancement"
          },
          "422": {
            "description": "Administrative command; use the indicated control action"
          },
          "502": {
            "description": "Draft rejected before commit; receipt identifies the failed phase",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "message": {
                      "type": "string"
                    },
                    "receipt": {
                      "type": "object",
                      "description": "Authoritative transaction receipt. A committed receipt proves the turn is already saved; a failed receipt proves gameplay did not advance and identifies the exact retry phase.",
                      "properties": {
                        "turnId": {
                          "type": "string"
                        },
                        "baseRevision": {
